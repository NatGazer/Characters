; Engine configuration file.
; Warrior of the Mind - character showcase and playable controller.

config_version=5

[application]

config/name="Warrior of the Mind"
config/description="Rigged, animated hero character: showcase, spring-bone cloth & hair, Jolt ragdoll, playable controller."
run/main_scene="res://scenes/showcase.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
jolt_physics_3d/simulation/max_bodies=4096

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
